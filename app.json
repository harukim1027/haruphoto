{
  "expo": {
    "name": "하루포토",
    "slug": "haruphoto",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.haru.haruphoto",
      "supportsTablet": false
    },
    "plugins": [
      "./plugins/withBuildFixes",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "포즈 가이드 촬영을 위해 카메라 접근이 필요합니다.",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "레퍼런스로 쓸 사진을 고르기 위해 앨범 접근이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "촬영한 사진을 갤러리에 저장하기 위해 필요합니다."
        }
      ],
      "expo-asset"
    ]
  }
}
